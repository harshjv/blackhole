---
interface Props {
  label: string
  command: string
}

const { label, command } = Astro.props
---

<li class="border-t border-edge first:border-t-0">
  <button
    type="button"
    data-copy={command}
    title="Click to copy"
    class="group flex w-full cursor-pointer items-center gap-4 py-3.5 text-left"
  >
    <span class="flex size-9 shrink-0 items-center justify-center rounded-lg border border-edge bg-ink text-muted group-hover:text-accent">
      <slot />
    </span>
    <span class="flex min-w-0 flex-col gap-0.5">
      <span class="text-paper">{label}</span>
      <code data-copy-text class="truncate text-xs text-dim group-hover:text-muted">{command}</code>
    </span>
  </button>
</li>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const text = button.querySelector<HTMLElement>('[data-copy-text]')
    button.addEventListener('click', async () => {
      const command = button.dataset.copy ?? ''
      await navigator.clipboard.writeText(command)
      if (!text) return
      text.textContent = 'copied to clipboard'
      text.classList.add('text-accent')
      setTimeout(() => {
        text.textContent = command
        text.classList.remove('text-accent')
      }, 1400)
    })
  }
</script>
